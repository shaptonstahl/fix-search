{
  "manifest_version": 3,
  "name": "Fix Search",
  "version": "1.0.0",
  "description": "Use Google to search sites with bad search, and hide Google AI Overviews.",
  "permissions": ["activeTab"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
